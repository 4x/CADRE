# Example environment for Connected Models. Copy to `.env` and fill in secrets:
#   Copy-Item .env.example .env
# `.env` itself is git-ignored; this file holds no secrets and is safe to commit.
# Every variable below is shown at its default value. The CLI reads `.env`
# from the working directory by default, so no flags are needed; explicit
# exports and uv-loaded files always win, and only absent variables are
# filled. Pass `--no-dotenv` before the command to skip `.env` entirely.

# API key for live Meta inference (answer, compare, revise, scenarios,
# curate, meta-smoke). Empty by default; inspection, reports, tests and
# curation review tools run offline without it. Never commit a real key.
META_API_KEY=

# Model override. Empty by default, which uses inference.toml (muse-spark-1.3).
# Precedence: --model flag, then LLM, then inference.toml. Any name must have
# researched per-token rates in MODEL_PRICING or loading fails closed.
LLM=

# Reasoning-effort override for every inference call. Empty by default,
# which uses inference.toml (low). One of: minimal, low, medium, high
# (case-insensitive; anything else fails closed before any API call).
REASONING=

# Let the grounded route fill question-implied assumptions (e.g. "6 months"
# means 0.5 years) instead of refusing. Default off. Accepted truthy values:
# 1, true, yes, on. The direct route in `compare` is unaffected.
FILL_IN_ASSUMPTIONS=0

# Let the composer fill pipeline gaps with bounded in-context calculation
# (max 3 LLM-computed steps per graph; scalar bindings only; priced calls
# settled through the usage ledger). Default off. Without it, step-bearing
# manifests are refused and every accepted answer stays fully grounded in
# reviewed models. Same truthy values as above.
CADRE_ALLOW_LLM_STEPS=0
